+    EXPECT_FALSE(LoopMatcher({config.loop, registration}).compute(work).selected);
+    config.loop.place_seed_enabled = true;
+    const auto recovered = LoopMatcher({config.loop, registration}).compute(work);
+    ASSERT_TRUE(recovered.selected);
+    EXPECT_LT((recovered.selected->measured_between - truth.inverse()).norm(), .01);
+    // Still reject a measurement outside the configured geometric translation limit.
+    config.loop.verification.translation_max = .01;
+    EXPECT_FALSE(LoopMatcher({config.loop, registration}).compute(work).selected);
+    config.loop.verification.translation_max = 3;
+    work.candidates.front().yaw_seed_rad.reset();
+    EXPECT_FALSE(LoopMatcher({config.loop, registration}).compute(work).selected);
+    work.candidates.front().yaw_seed_rad = .1;
+    work.latest.index = 30;
+    work.trajectory.back() = work.latest;
+    EXPECT_FALSE(LoopMatcher({config.loop, registration}).compute(work).selected);
+}
